{
  "manifest_version": 3,
  "name": "ClaimIt",
  "version": "1.0.0",
  "description": "Automatically claims limited-time free-to-keep games from Epic Games Store and Steam using your existing logged-in browser session.",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "ClaimIt",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://store-site-backend-static-ipv4.ak.epicgames.com/*",
    "https://store.epicgames.com/*",
    "https://payment-website-pci.ol.epicgames.com/*",
    "https://store.steampowered.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://api.telegram.org/*",
    "https://discord.com/*",
    "https://discordapp.com/*",
    "https://steamdb.info/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://store.epicgames.com/*",
        "https://payment-website-pci.ol.epicgames.com/*"
      ],
      "js": ["src/content/epic.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://store.steampowered.com/*"],
      "js": ["src/content/steam.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
